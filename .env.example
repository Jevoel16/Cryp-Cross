# Frontend build-time settings. Copy the block you need into .env (local) or your host's settings.
# Local = your machine, Development = a hosted preview (e.g. a Vercel Preview deployment), Production = the live site.
# VITE_ variables end up in the browser bundle, so never put secrets here.

# ===== Local =====
# Empty = call /api on the same origin (Vite proxies it to http://localhost:5000), keeping the session cookie first-party.
VITE_API_URL=
# Public site URL (no trailing slash), used for canonical links, sitemap.xml and robots.txt.
VITE_SITE_URL=http://localhost:3000

# ===== Development =====
VITE_API_URL=
VITE_SITE_URL=https://<preview-deployment>.vercel.app

# ===== Production =====
VITE_API_URL=
VITE_SITE_URL=https://<your-domain>
