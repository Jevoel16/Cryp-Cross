# Frontend build-time settings: copy one block into .env or your host. VITE_ values ship in the browser bundle, so no secrets.

# ===== Local =====
# Empty = call /api on the same origin (Vite proxies it to http://localhost:5000), keeping the session cookie first-party.
VITE_API_URL=
# Public site URL (no trailing slash), used for canonical links, sitemap.xml and robots.txt.
VITE_SITE_URL=http://localhost:3000

# ===== Development =====
VITE_API_URL=
VITE_SITE_URL=https://<preview-deployment>.vercel.app

# ===== Production =====
VITE_API_URL=
VITE_SITE_URL=https://<your-domain>
