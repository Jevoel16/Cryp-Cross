# Frontend build-time settings. Copy to .env (development) or set them in your host for production builds.

# Base URL of the API when it is on another origin. Leave empty to call /api on the same origin
# (development: Vite proxies /api to http://localhost:5000). Same origin keeps the session cookie first-party.
VITE_API_URL=

# Public site URL (https, no trailing slash). Used for canonical links and, at build time, sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.example.com
