# Copy to server/.env and fill in real values. Never commit .env.

# MongoDB connection string (e.g. MongoDB Atlas)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Port the Express API listens on
PORT=5000

# Comma-separated list of frontend origins allowed to call the API (CORS).
# Development defaults to http://localhost:3000 when unset; production blocks all browser origins when unset.
CORS_ORIGINS=http://localhost:3000

# Set to 1 when running behind a single reverse proxy (Render, Railway) so rate limiting uses real client IPs.
TRUST_PROXY=0

# Time zone that decides when the daily puzzle changes (IANA name). Default UTC.
PUZZLE_TZ=UTC
