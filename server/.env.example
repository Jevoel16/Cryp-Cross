# Copy to server/.env and fill in real values. Never commit .env.

# MongoDB connection string (e.g. MongoDB Atlas)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Port the Express API listens on
PORT=5000

# Comma-separated list of frontend origins allowed to call the API (CORS) and to send
# cookie-authenticated writes (CSRF check). Must include the site's own origin.
# Development defaults to http://localhost:3000 when unset; production blocks all browser origins when unset.
CORS_ORIGINS=http://localhost:3000

# Set to 1 when running behind a single reverse proxy (Render, Railway) so rate limiting uses real client IPs.
TRUST_PROXY=0

# Time zone that decides when the daily puzzle changes (IANA name). Default UTC.
PUZZLE_TZ=UTC

# Signs the session cookie. Required in production: a long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# Public site URL used in email links (verify email, reset password). Required in production.
APP_URL=http://localhost:3000

# SMTP server for account emails. Required in production. When SMTP_HOST is empty in
# development, emails are printed to the API console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cryp-Cross <no-reply@example.com>

# Max login/signup/reset attempts per IP per 15 minutes (default 10).
AUTH_RATE_LIMIT=10
