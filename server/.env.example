# API settings: copy one block into server/.env or your host, and never commit .env (details: docs/configuration.md).

# ===== Local =====
NODE_ENV=development
# MongoDB connection string; `npm run dev:memory` runs without one.
DATABASE_URL=mongodb://localhost:27017/cryp-cross
# Port the API listens on (the Vite proxy expects 5000; ignored on Vercel).
PORT=5000
# Frontend origins allowed to call the API and send cookie-authenticated writes.
CORS_ORIGINS=http://localhost:3000
# Proxy hops to trust for client IPs and https (1 behind Vercel, Render or Railway).
TRUST_PROXY=0
# IANA time zone that decides when the daily puzzle changes.
PUZZLE_TZ=UTC
# Long random string that signs the session cookie.
SESSION_SECRET=<random-string>
# Public site URL, where GitHub/Google sign-in returns to.
APP_URL=http://localhost:3000
# Public API origin for OAuth callbacks; empty means same origin as APP_URL.
API_URL=
# GitHub OAuth app; leave both empty to hide the GitHub button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client; leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Login and password-change attempts per IP per 15 minutes.
AUTH_RATE_LIMIT=10
# GitHub/Google sign-in requests per IP per 15 minutes (each sign-in uses two).
OAUTH_RATE_LIMIT=30
# Mixed into the puzzle seed so future puzzles can't be computed from the public source.
PUZZLE_SECRET=<random-string>
# Correct submissions sooner than this after opening the puzzle are refused.
MIN_SOLVE_SECONDS=30
# Shared demo account shown on the Log in page; set to off to disable it.
DEMO_ACCOUNT=on

# ===== Development =====
NODE_ENV=production
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dev-database>
PORT=5000
CORS_ORIGINS=https://<preview-deployment>.vercel.app
TRUST_PROXY=1
PUZZLE_TZ=UTC
SESSION_SECRET=<random-string>
APP_URL=https://<preview-deployment>.vercel.app
API_URL=
GITHUB_CLIENT_ID=<dev-github-client-id>
GITHUB_CLIENT_SECRET=<dev-github-client-secret>
GOOGLE_CLIENT_ID=<dev-google-client-id>
GOOGLE_CLIENT_SECRET=<dev-google-client-secret>
AUTH_RATE_LIMIT=10
OAUTH_RATE_LIMIT=30
PUZZLE_SECRET=<random-string>
MIN_SOLVE_SECONDS=30
DEMO_ACCOUNT=on

# ===== Production =====
NODE_ENV=production
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
PORT=5000
CORS_ORIGINS=https://<your-domain>
TRUST_PROXY=1
PUZZLE_TZ=UTC
SESSION_SECRET=<random-string>
APP_URL=https://<your-domain>
API_URL=
GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
AUTH_RATE_LIMIT=10
OAUTH_RATE_LIMIT=30
PUZZLE_SECRET=<random-string>
MIN_SOLVE_SECONDS=30
DEMO_ACCOUNT=on
