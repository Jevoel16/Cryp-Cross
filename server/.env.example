# Copy to server/.env and fill in real values. Never commit .env.
# On Vercel, set these in Project Settings > Environment Variables instead, with
# NODE_ENV=production, TRUST_PROXY=1, and APP_URL / CORS_ORIGINS = https://<project>.vercel.app
# (API_URL stays empty: the API is served on the site's own origin). PORT is not used there.

# MongoDB connection string (e.g. MongoDB Atlas)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Port the Express API listens on
PORT=5000

# Comma-separated list of frontend origins allowed to call the API (CORS) and to send
# cookie-authenticated writes (CSRF check). Must include the site's own origin.
# Development defaults to http://localhost:3000 when unset; production blocks all browser origins when unset.
CORS_ORIGINS=http://localhost:3000

# Set to 1 when running behind a single reverse proxy (Vercel, Render, Railway) so rate limiting uses real client IPs.
TRUST_PROXY=0

# Time zone that decides when the daily puzzle changes (IANA name). Default UTC.
PUZZLE_TZ=UTC

# Signs the session cookie. Required in production: a long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# Public site URL used in email links (verify email, reset password) and as the
# destination after GitHub/Google sign-in. Required in production.
APP_URL=http://localhost:3000

# Public origin of this API, used to build the OAuth callback URLs
# (<API_URL>/api/auth/oauth/github/callback and .../google/callback).
# Leave empty when the API is served on the same origin as the site (or through the
# Vite /api proxy in development); it then defaults to APP_URL.
API_URL=

# Sign in with GitHub (https://github.com/settings/developers > New OAuth App).
# Leave both empty to hide the GitHub button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sign in with Google (Google Cloud console > APIs & Services > Credentials >
# OAuth client ID, type "Web application"). Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP server for account emails. Required in production. When SMTP_HOST is empty in
# development, emails are printed to the API console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cryp-Cross <no-reply@example.com>

# Max login/signup/reset attempts per IP per 15 minutes (default 10).
AUTH_RATE_LIMIT=10

# Secret mixed into the daily puzzle seed so puzzles can't be worked out in advance from
# the public source code. Required in production; changing it changes future puzzles only.
PUZZLE_SECRET=change-me-too

# Correct submissions faster than this many seconds after opening the puzzle are refused
# (they can only come from answers prepared before the timer started). Default 30.
MIN_SOLVE_SECONDS=30
